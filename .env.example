# ─────────────────────────────────────────────────────────────────────────────
# 508 Filmzz — booking notification channels
#
# Every channel is optional and independent. Any that isn't configured is
# skipped; any that fails is logged. The lead is still captured either way, so
# a dead Twilio balance can never cost you a booking.
#
# Copy to .env.local for development, and set the same values in your host's
# environment settings for production.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. SMS to your phone (Twilio) ────────────────────────────────────────────
# console.twilio.com → Account Info for the SID and auth token.
# The FROM number must be a Twilio number you own, in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550001111

# Where booking alerts are texted. Defaults to the number in src/data/site.ts.
SMS_TO_NUMBER=+18649154071


# ── 2. Email (Resend) ────────────────────────────────────────────────────────
# resend.com → API Keys. Sends BOTH the studio notification and the customer's
# confirmation, so this one key powers two of the four channels.
RESEND_API_KEY=

# Where booking notifications land.
CONTACT_TO=drew@508filmzz.com

# Sender. The domain must be verified in your Resend account, otherwise use
# "508 Filmzz <onboarding@resend.dev>" for testing.
CONTACT_FROM="508 Filmzz <bookings@508filmzz.com>"


# ── 3. Google Sheet ──────────────────────────────────────────────────────────
# 1. Google Cloud console → create a project → enable the Google Sheets API.
# 2. Create a Service Account → Keys → Add key → JSON.
# 3. Copy "client_email" and "private_key" out of that JSON below.
# 4. IMPORTANT: open your sheet and Share it with the client_email as an Editor,
#    or every append returns 403.
# 5. Add a header row to the tab (see SHEET_HEADERS in src/lib/notify/sheets.ts):
#    Received | Name | Phone | Email | Service | Budget | Preferred Shoot Date |
#    Message | Business Name | Location | Attachments
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Paste the whole key on one line, keeping the literal \n sequences, in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Tab name. Defaults to "Leads".
GOOGLE_SHEET_TAB=Leads


# ─────────────────────────────────────────────────────────────────────────────
# Search visibility  ← THE SOFT-LAUNCH SWITCH
#
# Unset or anything except "true"  → site is LIVE but NOINDEX. Anyone with the
#                                     link sees it; Google never lists it.
# "true"                           → site is fully indexable.
#
# Fail-closed on purpose: a typo keeps you private rather than accidentally
# public. Read at BUILD time, so you must redeploy after changing it.
#
# Verify after deploy:  curl -s https://www.508filmzz.com/robots.txt
#   private → "Disallow: /"      public → "Allow: /"
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_INDEXABLE=


# ─────────────────────────────────────────────────────────────────────────────
# Analytics & verification
#
# All optional. Each tag renders only when its variable is set, so leaving these
# blank ships zero third-party JavaScript. NEXT_PUBLIC_ vars are exposed to the
# browser by design — never put a secret in one.
# ─────────────────────────────────────────────────────────────────────────────

# ── 4. Google Search Console ─────────────────────────────────────────────────
# search.google.com/search-console → Add property (URL prefix) → HTML tag.
# Paste ONLY the content="..." value, not the whole meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── 5. Google Analytics 4 ────────────────────────────────────────────────────
# analytics.google.com → Admin → Data Streams → your stream → Measurement ID.
# Leave blank if you run GA4 through GTM instead — setting both double-counts
# every pageview.
NEXT_PUBLIC_GA_ID=

# ── 6. Google Tag Manager ────────────────────────────────────────────────────
# tagmanager.google.com → container ID, format GTM-XXXXXXX.
NEXT_PUBLIC_GTM_ID=

# ── 7. Microsoft Clarity ─────────────────────────────────────────────────────
# clarity.microsoft.com → Settings → Overview → Project ID.
# Free heatmaps and session recordings — genuinely useful on a portfolio site
# for seeing how far people scroll before they bounce.
NEXT_PUBLIC_CLARITY_ID=

# ── 8. Meta Pixel ────────────────────────────────────────────────────────────
# business.facebook.com → Events Manager → Data Sources → your pixel → ID.
# Only needed if you run Facebook/Instagram ads.
NEXT_PUBLIC_META_PIXEL_ID=
